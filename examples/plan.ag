const MAX: int = 100;
const MASK: int = 0xFF_FF;
const FLAGS: int = 0b1010_0110;
const TABLE: int = comptime fib(10);
static var counter: int = 0;

comptime func fib(n: int) -> int {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

struct Point {
    pub x: int,
    pub y: int,
}

impl Point {
    func origin() -> Self => Point { x: 0, y: 0 };

    func dist(self) -> float {
        return m::sqrt(self.x * self.x + self.y * self.y);
    }

    func moved(self, dx: int, dy: int) -> Self {
        return Point { x: self.x + dx, ..self };
    }

    func shift(mut self, dx: int, dy: int) -> void {
        self.x += dx;
        self.y += dy;
    }
}

struct Vec2 {
    x: float,
    y: float,
}

operator (l: Vec2) + (r: Vec2) -> Vec2 => Vec2 { x: l.x + r.x, y: l.y + r.y };
operator (l: Vec2) * (k: float) -> Vec2 => Vec2 { x: l.x * k, y: l.y * k };
operator (v: Vec2) [] (i: int) -> float => i == 0 ? v.x : v.y;

enum Status {
    Ok,
    Error(string),
    Pending(int),
    Moved { x: int, y: int },
}

impl Status {
    func is_done(self) -> bool {
        return match self {
            Status::Ok => true,
            _ => false,
        };
    }
}

trait Shape {
    func area(self) -> float;

    func describe(self) -> string => f"area = {self.area():.2}";
}

struct Circle {
    r: float,
}

struct Rect {
    w: float,
    h: float,
}

impl Shape for Circle {
    func area(self) -> float {
        return m::PI * self.r ** 2;
    }
}

impl Shape for Rect {
    func area(self) -> float => self.w * self.h;
}

struct Stack<T> {
    items: T[],
}

impl<T> Stack<T> {
    func new() -> Self => Stack { items: [] };

    func push(mut self, item: T) -> void {
        self.items.append(item);
    }

    func pop(mut self) -> T? {
        return self.items.pop();
    }
}

struct Ring<T, const N: int> {
    data: T[N],
    head: int,
}

func max<T>(a: T, b: T) -> T where T: Ord {
    return a > b ? a : b;
}

func largest<T>(items: T[]) -> T? where T: Ord + Copy {
    guard (items.len() > 0) else {
        return null;
    }
    var best = items[0];
    for item in items[1..] {
        best = max(best, item);
    }
    return best;
}

func add(num1: int, num2: int) -> int {
    return num1 + num2;
}

func greet(name: string = "world") -> void {
    println("hello, " + name);
}

func sum(nums: int...) -> int {
    var total = 0;
    for n in nums {
        total += n;
    }
    return total;
}

func square(x: int) -> int => x * x;

@inline
func clamp(v: int, lo: int, hi: int) -> int => v < lo ? lo : v > hi ? hi : v;

@deprecated("use add instead")
func plus(a: int, b: int) -> int => a + b;

func divide(a: int, b: int) -> Result<int, string> {
    if (b == 0) {
        return Err("divide by zero");
    }
    return Ok(a / b);
}

func safeDivide(a: int, b: int) -> Result<int, string> {
    let value = divide(a, b)?;
    return Ok(value);
}

func parsePositive(text: string) -> Result<int, string> {
    let n = parse_int(text) orelse return Err("not a number");
    guard (n > 0) else {
        return Err("must be positive");
    }
    return Ok(n);
}

func makeAdder(base: int) -> Callback {
    let adder = (n: int) -> int => n + base;
    return adder;
}

func makeCounter() -> func() -> int {
    var n = 0;
    return move () -> int {
        n += 1;
        return n;
    };
}

func readConfig(path: string) -> Result<string, string> {
    with (let file = fs::open(path)?) {
        return file.read_all();
    }
}

func copyBuffer(size: int) -> void {
    let buf = alloc<char>(size);
    defer free(buf);

    let log = fs::open("log.txt")!;
    defer log.close();

    println("working");
}

async func fetch(url: string) -> Result<string, string> {
    let body = await http::get(url)?;
    return Ok(body);
}

func rawAccess(ptr: int*, n: int) -> int {
    var total = 0;
    unsafe {
        for i in 0..n {
            total += *(ptr + i);
        }
    }
    return total;
}

test "add works" {
    assert(add(2, 3) == 5);
    assert(add(-1, 1) == 0, "should cancel out");
}

test "divide by zero fails" {
    assert(divide(1, 0).is_err());
}

