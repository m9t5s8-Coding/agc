# Recently added language features:
#   named arguments, struct destructuring, `box`, pipelines (`|>`), `??=`,
#   `as` casts, `in` membership, map literals and map iteration, `spawn`.
#
# Build from the repository root with:
#   build/agc examples/new_features/main.ag -I lib -o /tmp/ag_new_features
#   /tmp/ag_new_features

mod ag::io;

import ag::io { println };

struct Point {
  x: int,
  y: int,
}

func offset(value: int, by: int) -> int => value + by;

func main() -> int {
  # Named arguments may appear in any order.
  println(offset(by: 2, value: 5));   # 7

  # Struct destructuring binds fields to local names.
  let p = Point { x: 3, y: 4 };
  let Point { x, y } = p;
  println(x + y);                     # 7

  # `box` marks a heap value; aggregates already live on the heap.
  let q = box Point { x: 10, y: 20 };
  println(q.x + q.y);                 # 30

  # `value |> fn(args)` passes the value as the first argument.
  println(3 |> offset(4));            # 7

  # `??=` only assigns when the current value is zero/absent.
  var maybe: int = 0;
  maybe ??= 42;
  println(maybe);                     # 42
  maybe ??= 7;
  println(maybe);                     # 42

  # `as` converts between primitive representations; char truncates to 8 bits.
  let wide: int = 300;
  let narrow = wide as char;
  println(narrow as int);             # 44

  # `in` tests membership in ranges and array literals.
  println(3 in 1..=5);                # true
  println(9 in 1..=5);                # false
  println(2 in [1, 2, 3]);            # true

  # Map literals store key/value pairs; `for (key, value)` walks them.
  let scores = map { "ann": 90, "bob": 75 };
  var total: int = 0;
  for (name, score) in scores {
    println(name);
    println(score);
    total += score;
  }
  println(total);                     # 165

  # `spawn` currently runs its block synchronously.
  spawn {
    println(99);
  }

  return 0;
}
