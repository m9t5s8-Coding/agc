# Visibility demo.
#
# Build and run:
#   build/agc examples/visibility.ag -o visibility-demo
#   ./visibility-demo
#
# LLVM backend:
#   build/agc examples/visibility.ag --llvm -o visibility-demo-llvm
#   ./visibility-demo-llvm

mod account {
    pub struct Account {
        pub id: int,
        secret: int,
    }

    impl Account {
        # Private method: only code inside `account` may call this.
        func reveal(self) -> int => self.secret;

        # Public methods form the exported interface.
        pub func label(self) -> int => self.id;

        pub func score(self) -> int => self.reveal();
    }

    pub func make_account(id: int, secret: int) -> Account =>
        Account { id: id, secret: secret };
}

import account { Account, make_account };

func main() -> int {
    let value: Account = make_account(4, 8);

    # These would be compile errors outside `account`:
    #   let hidden: int = value.secret;
    #   let private_method: int = value.reveal();
    #   let partial: Account = Account { id: 1 };  # has a private field

    return value.label() + value.score();
}
