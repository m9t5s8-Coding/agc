# AGC all-features tour
#
# This file is a valid, runnable example of the language features currently
# supported by the compiler:
#   * functions, prototypes, overloads, and pointer return types
#   * let and var bindings, if/else, while, return, read, write, and exit
#   * integer arithmetic, comparisons, logical operators, bitwise operators,
#     and shifts
#   * string literals, string escapes, string indexing, and byte writes
#   * prefix and postfix unary operators
#   * user-defined operator overloading in canonical and infix forms
#   * explicit operator calls
#   * user-defined operator[]
#   * int*, int**, void*, and user-defined pointer types such as ostream*
#   * alloc/free and malloc/dealloc
#
# read() is demonstrated by read_demo(), which is intentionally not called so
# this program stays non-interactive.

# ---------------------------------------------------------------------------
# String helpers
# ---------------------------------------------------------------------------

func strlen(text : string) -> int {
  var length : int = 0;
  while (text[length] != 0) {
    length = length + 1;
  }
  return length;
}

func to_string(value : int) -> string {
  var buffer : string = alloc(32);
  var number : int = value;
  var length : int = 0;
  var negative : int = 0;
  var digit : int = 0;
  var left : int = 0;
  var right : int = 0;
  var temporary : int = 0;

  if (number == 0) {
    buffer[0] = 48;  # '0'
    buffer[1] = 0;
    return buffer;
  }

  if (number < 0) {
    negative = 1;
  }

  while (number != 0) {
    digit = number % 10;
    if (digit < 0) {
      digit = 0 - digit;
    }
    buffer[length] = 48 + digit;
    length = length + 1;
    number = number / 10;
  }

  if (negative == 1) {
    buffer[length] = 45;  # '-'
    length = length + 1;
  }
  buffer[length] = 0;

  left = 0;
  right = length - 1;
  while (left < right) {
    temporary = buffer[left];
    buffer[left] = buffer[right];
    buffer[right] = temporary;
    left = left + 1;
    right = right - 1;
  }
  return buffer;
}

# ---------------------------------------------------------------------------
# Function prototypes and overloads
# ---------------------------------------------------------------------------

func describe(value : int) -> string;
func describe(value : string) -> string;

func describe(value : int) -> string {
  return "integer overload\n";
}

func describe(value : string) -> string {
  return value;
}

# Overloads that differ only by pointer type.
func forward(values : int*) -> int* {
  return values;
}

func forward(table : int**) -> int** {
  return table;
}

func forward(stream : ostream*) -> ostream* {
  return stream;
}

# A void function that mutates memory owned by the caller.  The explicit
# return statement is required by the current void-function implementation.
func fill(buffer : string, first : int, second : int) -> void {
  buffer[0] = first;
  buffer[1] = second;
  buffer[2] = 0;
  return;
}

func print_line(label : string, value : int) -> void {
  write(label, strlen(label));
  var number : string = to_string(value);
  write(number, strlen(number));
  write("\n", 1);
  free(number);
  return;
}

# read() is supported, but this demo is not called to keep the program
# non-interactive.
func read_demo() -> void {
  var input : string = alloc(64);
  read(input, 64);
  write(input, 64);
  free(input);
  return;
}

# ---------------------------------------------------------------------------
# Operator prototypes and definitions
# ---------------------------------------------------------------------------

# Prototype followed by the definition of the same integer operator.
operator+(left : int, right : int) -> int;
operator+(left : int, right : int) -> int {
  return left + right;
}

# Canonical string concatenation.
operator+(left : string, right : string) -> string {
  let left_size : int = strlen(left);
  let right_size : int = strlen(right);
  var result : string = alloc(left_size + right_size + 1);
  var index : int = 0;

  while (index < left_size) {
    result[index] = left[index];
    index = index + 1;
  }

  index = 0;
  while (index < right_size) {
    result[left_size + index] = right[index];
    index = index + 1;
  }

  result[left_size + right_size] = 0;
  return result;
}

# Infix declaration form for a string stream.
operator (text : string) << (value : string) -> string {
  return text + value;
}

operator (text : string) << (value : int) -> string {
  var number : string = to_string(value);
  var result : string = text + number;
  free(number);
  return result;
}

# Infix declaration form using a pointer to a user-defined type.
operator (stream : ostream*) << (value : int) -> ostream* {
  return stream;
}

# Unary operator overloads.
operator-(value : int) -> int {
  return 0 - value;
}

operator*(value : int*) -> int {
  return 77;
}

operator++(value : int) -> int {
  return value + 10;
}

# Assignment syntax is built in, but an assignment operator can still be
# declared and called explicitly as operator=.
operator=(left : int, right : int) -> int {
  return right;
}

# Canonical user-defined indexing for int* values.  String indexing remains
# the compiler's built-in byte-index operation.
operator[](values : int*, index : int) -> int {
  return 100 + index;
}

# ---------------------------------------------------------------------------
# Main feature tour
# ---------------------------------------------------------------------------

func main() -> int {
  let title : string = "AGC all-features demo\n";
  write(title, strlen(title));

  # Function prototypes and overloads.
  let integer_description : string = describe(7);
  let string_description : string = describe("string overload\n");
  write(integer_description, strlen(integer_description));
  write(string_description, strlen(string_description));

  # String escapes: tab and newline.
  let escaped : string = "escapes: tab[\t] newline follows\n";
  write(escaped, strlen(escaped));

  # Arithmetic, comparisons, logical operators, bitwise operators, and shifts.
  let arithmetic : int = ((20 + 4) * 3 - 2) / 5 % 5;
  let shifts : int = (1 << 6) | (5 & 3) ^ (~0);
  let comparisons : int = (arithmetic >= 0) + (arithmetic != 0) + (3 < 4) + (5 <= 5);
  let logic : int = (arithmetic > 0 && shifts != 0) || 0;
  var flag : bool = 1;

  if (flag && logic) {
    print_line("arithmetic: ", arithmetic);
    print_line("shifts: ", shifts);
    print_line("comparisons: ", comparisons);
  } else {
    let failed : string = "arithmetic checks failed\n";
    write(failed, strlen(failed));
  }

  # Prefix and postfix unary operators.
  var counter : int = 5;
  let post_increment : int = counter++;
  let pre_increment : int = ++counter;
  let post_decrement : int = counter--;
  let pre_decrement : int = --counter;
  counter++;

  let positive : int = +counter;
  let negative : int = -counter;
  let explicit_negative : int = operator-(counter);
  let complemented : int = ~counter;
  let logical_not : int = !counter;
  let explicit_increment : int = operator++(counter);

  print_line("counter: ", counter);
  print_line("increment/decrement total: ",
             post_increment + pre_increment + post_decrement + pre_decrement);
  print_line("unary total: ",
             positive + negative + explicit_negative + complemented + logical_not + explicit_increment);

  # Implicit and explicit binary operator calls.
  let implicit_sum : int = 4 + 5;
  let explicit_sum : int = operator+(4, 5);
  let explicit_assignment : int = operator=(1, 2);
  print_line("implicit + explicit +: ", implicit_sum + explicit_sum);
  print_line("explicit operator=: ", explicit_assignment);

  # Infix string stream operators and explicit calls.
  var text : string = "operators";
  var first_text : string = text << " + indexing";
  var second_text : string = first_text << 42;
  free(first_text);
  text = second_text;
  write(text, strlen(text));
  write("\n", 1);

  let explicit_text : string = operator+(text, "!");
  let explicit_stream : string = operator<<(explicit_text, " explicit");
  write(explicit_stream, strlen(explicit_stream));
  write("\n", 1);

  # ostream*-style stream operator from the requested syntax.
  var stream : ostream*;
  stream = forward(stream);
  if ((stream << 7) == stream) {
    let stream_message : string = "ostream* operator<< works\n";
    write(stream_message, strlen(stream_message));
  }

  # Raw allocation, void*, malloc/dealloc, and pointer conversions.
  var raw : void* = malloc(16);
  var raw_bytes : string = raw;
  raw_bytes[0] = 82;  # 'R'
  raw_bytes[1] = 65;  # 'A'
  raw_bytes[2] = 87;  # 'W'
  raw_bytes[3] = 0;
  write(raw_bytes, strlen(raw_bytes));
  write("\n", 1);

  var typed : int* = raw;
  typed = forward(typed);
  var table : int**;
  table = forward(table);

  let dereferenced : int = *typed;
  let explicit_dereferenced : int = operator*(typed);
  dealloc(raw);

  # User-defined operator[] and indexing inside a larger expression.
  var numbers : int*;
  let indexed : int = numbers[2];
  let explicit_indexed : int = operator[](numbers, 3);
  let indexed_sum : int = numbers[1] + numbers[2];
  print_line("custom index: ", indexed);
  print_line("explicit index: ", explicit_indexed);
  print_line("index sum: ", indexed_sum);

  # String-buffer indexing, prefix/postfix updates, and a function mutating
  # memory owned by the caller.
  var buffer : string = alloc(4);
  fill(buffer, 65, 66);

  let old_byte : int = buffer[0]++;
  let new_byte : int = ++buffer[0];
  let byte_total : int = old_byte + new_byte + buffer[0] + buffer[1];

  write(buffer, 2);
  write("\n", 1);
  print_line("byte total: ", byte_total);
  free(buffer);

  # Combine the results so every computed value is observable.
  let total : int = arithmetic + shifts + comparisons + logic + counter +
                    post_increment + pre_increment + post_decrement +
                    pre_decrement + positive + negative + explicit_negative +
                    complemented + logical_not + explicit_increment +
                    implicit_sum + explicit_sum + explicit_assignment +
                    indexed + explicit_indexed + indexed_sum + dereferenced +
                    explicit_dereferenced + old_byte + new_byte + byte_total;
  print_line("total: ", total);

  if (total != 0) {
    let done : string = "all features executed\n";
    write(done, strlen(done));
  } else {
    let failure : string = "feature check failed\n";
    write(failure, strlen(failure));
  }

  free(text);
  free(explicit_text);
  free(explicit_stream);

  # Demonstrate the exit statement after all resources are released.
  exit(0);
  return 0;
}
