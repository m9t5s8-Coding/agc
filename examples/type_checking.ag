# User-defined type checking.
#
# A value declaration such as `Point` must name a declared struct or enum.
# Pointers to incomplete types are allowed so FFI-style opaque handles can be
# represented without defining their layout.
#
# Build and run:
#   build/agc examples/type_checking.ag -o type-checking
#   ./type-checking

struct Point {
    x: int,
    y: int,
}

func point_sum(point: Point) -> int => point.x + point.y;

# NativeHandle is intentionally never defined.  Only pointers to it are used,
# which is enough to model an opaque handle.
func handle_is_valid(handle: NativeHandle*) -> int => 1;

func main() -> int {
    let point: Point = Point { x: 20, y: 22 };
    var handle: NativeHandle*;

    return point_sum(point) + handle_is_valid(handle);
}
