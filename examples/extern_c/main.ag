# Calling C functions declared in an `extern "c"` block.
#
# Build from the repository root with:
#   build/agc examples/extern_c/main.ag -o /tmp/ag_extern_demo
#   /tmp/ag_extern_demo
#
# These symbols come from the C runtime that clang links automatically.  For a
# library outside the default runtime, add `-L <dir> -l <name>` or pass an
# object/archive path with `--link-arg <path>`.

extern "c" {
  func strlen(text: char*) -> int;
  func puts(text: char*) -> int;
}

func main() -> int {
  puts("hello from libc");

  # `strlen` returns a C `int` (i32), sign-extended into an AGC `int`.
  let length: int = strlen("hello");
  if (length != 5) {
    return 1;
  }

  return 0;
}
