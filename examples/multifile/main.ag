# Multi-file AGC demo.
#
# Build and run:
#   build/agc examples/multifile/main.ag -o multifile-demo
#   ./multifile-demo
#
# LLVM backend:
#   build/agc examples/multifile/main.ag --llvm -o multifile-demo-llvm
#   ./multifile-demo-llvm

mod mathx;
mod model;
mod io;

import mathx { square };
import model { Point, Status, classify };
import io { print_text, print_line };

func main() -> int {
    print_text("multi-file demo\n");

    let point: Point = Point { x: 1, y: 2 };
    let combined: Point = point.moved(4, 6);
    let point_sum: int = combined.sum();
    let magnitude: int = combined.magnitude_squared();

    let squared: int = square(6);
    let status_value: int = classify(Status::Pending(7));
    let error_value: int = classify(Status::Error("failed"));
    let ok_status: Status = Status::Ok;
    let is_ok: bool = ok_status.is_ok();

    print_text("point sum: ");
    print_line(point_sum);
    print_text("magnitude squared: ");
    print_line(magnitude);
    print_text("squared: ");
    print_line(squared);
    print_text("status values: ");
    print_line(status_value);
    print_text("error value: ");
    print_line(error_value);
    print_text("ok: ");
    print_line(is_ok);

    let total: int = point_sum + magnitude + squared + status_value + error_value + is_ok;
    print_text("total: ");
    print_line(total);

    return total;
}
