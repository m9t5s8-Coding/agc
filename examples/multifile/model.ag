import mathx { square };

pub struct Point {
    pub x: int,
    pub y: int,
}

impl Point {
    # Private helper: only code in this module may call `offset`.
    func offset(self, dx: int, dy: int) -> Point =>
        Point { x: self.x + dx, y: self.y + dy };

    # Public method: the exported surface of Point.
    pub func moved(self, dx: int, dy: int) -> Point => self.offset(dx, dy);

    pub func sum(self) -> int => self.x + self.y;

    pub func magnitude_squared(self) -> int =>
        square(self.x) + square(self.y);
}

pub enum Status {
    Ok,
    Error(string),
    Pending(int),
    Moved { x: int, y: int },
}

impl Status {
    pub func is_ok(self) -> bool => match self {
        Status::Ok => true,
        _ => false,
    };
}

pub func classify(status: Status) -> int {
    return match status {
        Status::Ok => 1,
        Status::Error(message) => 2,
        Status::Pending(code) if code > 5 => code,
        Status::Pending(code) => code + 10,
        Status::Moved { x, y } => x + y,
        _ => 0,
    };
}
